<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Ledger — Invoices & Quotes</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
        onerror="var s=document.createElement('script'); s.src='vendor/jspdf.umd.min.js'; document.head.appendChild(s);"></script>
<style>
  :root{
    --paper:#EDE9DD;
    --paper-line:#D9D3C1;
    --ink:#1F2D3D;
    --ink-soft:#5B6470;
    --stamp:#A13D2C;
    --brass:#A6874F;
    --brass-soft:#EFE6D2;
    --white:#FBFAF6;
    --radius:2px;
    --serif:'Fraunces', 'Georgia', serif;
    --sans:'Inter', -apple-system, sans-serif;
    --mono:'JetBrains Mono', 'Courier New', monospace;
    --tabbar-h:64px;
  }
  @font-face{ font-family:'Fraunces'; src:local('Georgia'); }
  *{box-sizing:border-box; min-width:0; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:var(--paper);color:var(--ink);font-family:var(--sans);overflow-x:hidden;width:100%;}
  body{min-height:100vh;}

  .app{max-width:640px;margin:0 auto;padding-bottom:calc(var(--tabbar-h) + 16px);min-height:100vh;}
  .screen{display:none;padding:20px 18px 8px;}
  .screen.active{display:block;}

  .brand{display:flex;align-items:baseline;gap:10px;margin-bottom:22px;padding-top:4px;}
  .brand-mark{width:26px;height:26px;border:1.5px solid var(--ink);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:14px;font-weight:600;flex-shrink:0;}
  .brand h1{font-family:var(--serif);font-size:20px;font-weight:600;margin:0;letter-spacing:0.2px;}
  .brand .tag{font-family:var(--mono);font-size:9px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:1.2px;margin-left:2px;}

  .field-group{margin-bottom:20px;}
  .field-group .grp-label{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:1.1px;color:var(--brass);margin-bottom:9px;display:block;font-weight:600;}
  .row{display:flex;gap:10px;margin-bottom:8px;width:100%;}
  .row > *{flex:1 1 0;width:100%;}
  @media (max-width:380px){ .row{flex-direction:column;} }
  label.small{display:block;font-size:11px;color:var(--ink-soft);margin-bottom:4px;}
  input[type=text], input[type=number], input[type=date], textarea, select{
    width:100%;padding:9px 10px;border:1px solid var(--paper-line);background:var(--white);
    border-radius:var(--radius);font-family:var(--sans);font-size:13.5px;color:var(--ink);
    max-width:100%;
  }
  input:focus, textarea:focus, select:focus{outline:none;border-color:var(--brass);}
  textarea{resize:vertical;min-height:50px;}

  .items{border:1px solid var(--paper-line);border-radius:var(--radius);overflow:hidden;background:var(--white);}
  .item-row{display:grid;grid-template-columns: 1fr 44px 60px 24px;gap:6px;padding:9px;border-bottom:1px solid var(--paper-line);align-items:center;}
  .item-row:last-child{border-bottom:none;}
  .item-row input{padding:7px 6px;font-size:12.5px;min-width:0;}
  .item-row .rm{background:none;border:none;color:var(--ink-soft);cursor:pointer;font-size:16px;line-height:1;padding:2px;}
  .item-row .rm:hover{color:var(--stamp);}
  .add-item{width:100%;padding:10px;background:var(--white);border:1px dashed var(--paper-line);border-radius:var(--radius);color:var(--ink-soft);font-family:var(--mono);font-size:11px;letter-spacing:0.5px;text-transform:uppercase;cursor:pointer;margin-top:8px;}
  .add-item:hover{border-color:var(--brass);color:var(--brass);}

  .btn-primary{width:100%;padding:13px;background:var(--ink);color:var(--white);border:none;border-radius:var(--radius);font-family:var(--mono);font-size:12px;letter-spacing:1px;text-transform:uppercase;cursor:pointer;margin-top:8px;}
  .btn-primary:active{background:var(--stamp);}
  .btn-primary:disabled{opacity:0.6;}
  .btn-secondary{width:100%;padding:11px;background:transparent;color:var(--ink);border:1px solid var(--ink);border-radius:var(--radius);font-family:var(--mono);font-size:11px;letter-spacing:1px;text-transform:uppercase;cursor:pointer;margin-top:10px;}

  .pro-box{margin-top:22px;padding:14px 16px;background:var(--brass-soft);border:1px solid var(--brass);border-radius:var(--radius);}
  .pro-box .grp-label{margin-bottom:6px;}
  .pro-box p{font-size:11.5px;color:var(--ink-soft);margin:0 0 10px;line-height:1.5;}
  .pro-box input{margin-bottom:8px;}
  .pro-status{font-size:11px;font-family:var(--mono);margin-top:6px;}
  .pro-status.active{color:#3D7A4F;}
  .pro-status.inactive{color:var(--ink-soft);}

  /* ---- Preview sheet (shown inline on Home, below the form) ---- */
  .preview-toggle{display:flex;gap:8px;margin:22px 0 10px;}
  .preview-toggle button{flex:1;padding:11px;font-family:var(--mono);font-size:11px;letter-spacing:0.8px;text-transform:uppercase;border-radius:var(--radius);border:1px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;}
  .preview-toggle button.active{background:var(--ink);color:var(--white);}

  .sheet-wrap{display:none;}
  .sheet-wrap.active{display:block;}
  .sheet{width:100%;background:var(--white);box-shadow:0 4px 18px rgba(31,45,61,0.12);position:relative;padding:26px 22px 24px;margin-top:4px;overflow:hidden;}
  .sheet::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--ink);z-index:2;}
  .sheet-logo-bg{position:absolute;inset:0;background-repeat:no-repeat;background-position:center;background-size:55% auto;z-index:0;pointer-events:none;}
  .sheet-content{position:relative;z-index:1;}
  .sheet-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid var(--ink);padding-bottom:14px;margin-bottom:18px;gap:10px;}
  .sheet-brand h2{font-family:var(--serif);font-size:19px;margin:0 0 4px;font-weight:600;word-break:break-word;}
  .sheet-brand p{font-size:11px;color:var(--ink-soft);margin:0;line-height:1.5;white-space:pre-line;}
  .doc-type{text-align:right;flex-shrink:0;}
  .doc-type .kind{font-family:var(--mono);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--stamp);font-weight:600;}
  .doc-type .num{font-family:var(--serif);font-size:16px;margin-top:4px;}
  .doc-type .date{font-size:10px;color:var(--ink-soft);margin-top:5px;}

  .bill-to{margin-bottom:20px;}
  .bill-to .grp-label{font-family:var(--mono);font-size:9.5px;text-transform:uppercase;letter-spacing:1.1px;color:var(--brass);margin-bottom:6px;font-weight:600;}
  .bill-to .name{font-family:var(--serif);font-size:15px;margin-bottom:2px;word-break:break-word;}
  .bill-to .meta{font-size:11px;color:var(--ink-soft);white-space:pre-line;line-height:1.5;}

  table.items-table{width:100%;border-collapse:collapse;margin-bottom:16px;}
  table.items-table thead th{text-align:left;font-family:var(--mono);font-size:8.5px;text-transform:uppercase;letter-spacing:0.8px;color:var(--ink-soft);border-bottom:1.5px solid var(--ink);padding-bottom:7px;font-weight:600;}
  table.items-table thead th.num{text-align:right;}
  table.items-table tbody td{padding:8px 0;border-bottom:1px solid var(--paper-line);font-size:12px;word-break:break-word;}
  table.items-table tbody td.num{text-align:right;font-family:var(--mono);white-space:nowrap;}

  .totals{margin-left:auto;width:180px;margin-top:8px;max-width:100%;}
  .totals .trow{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;}
  .totals .trow.grand{border-top:2px solid var(--ink);margin-top:6px;padding-top:9px;font-family:var(--serif);font-size:16px;font-weight:600;}
  .totals .trow span:last-child{font-family:var(--mono);}

  .notes-block{margin-top:22px;padding-top:14px;border-top:1px dashed var(--paper-line);}
  .notes-block .grp-label{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:0.8px;color:var(--brass);margin-bottom:6px;font-weight:600;}
  .notes-block p{font-size:11px;color:var(--ink-soft);white-space:pre-line;line-height:1.6;margin:0;word-break:break-word;}

  .stamp-el{width:76px;height:76px;border:2.5px solid var(--stamp);border-radius:50%;display:flex;align-items:center;justify-content:center;transform:rotate(-10deg);opacity:0.85;margin:26px 0 0 auto;}
  .stamp-el span{font-family:var(--mono);font-size:10px;font-weight:700;color:var(--stamp);letter-spacing:0.8px;text-transform:uppercase;text-align:center;line-height:1.3;}
  .watermark{margin-top:18px;text-align:center;font-family:var(--mono);font-size:9px;color:var(--paper-line);letter-spacing:1px;}

  /* ---- History ---- */
  .hist-item{background:var(--white);border:1px solid var(--paper-line);border-radius:var(--radius);padding:14px 16px;margin-bottom:10px;-webkit-tap-highlight-color:transparent;}
  .hist-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;}
  .hist-top .kind-num{font-family:var(--mono);font-size:10px;color:var(--brass);letter-spacing:0.5px;}
  .hist-top .amt{font-family:var(--serif);font-size:16px;font-weight:600;}
  .hist-mid{font-size:13.5px;margin-bottom:2px;}
  .hist-date{font-size:10.5px;color:var(--ink-soft);font-family:var(--mono);}
  .empty-state{text-align:center;padding:60px 20px;color:var(--ink-soft);}
  .empty-state .icon{font-size:34px;margin-bottom:12px;opacity:0.5;}
  .empty-state p{font-size:13px;line-height:1.6;margin:0;}

  /* ---- Tab bar ---- */
  .tabbar{position:fixed;bottom:0;left:0;right:0;height:var(--tabbar-h);background:var(--white);border-top:1px solid var(--paper-line);display:flex;z-index:50;padding-bottom:env(safe-area-inset-bottom);}
  .tab-btn{flex:1;border:none;background:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--ink-soft);font-family:var(--sans);font-size:10.5px;cursor:pointer;padding:6px 0;}
  .tab-btn .ic{font-size:19px;line-height:1;}
  .tab-btn.active{color:var(--stamp);}

  /* ---- Welcome overlay ---- */
  .welcome-overlay{position:fixed;inset:0;background:var(--paper);z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 30px;text-align:center;}
  .welcome-overlay .brand-mark{width:56px;height:56px;font-size:28px;margin-bottom:20px;border-width:2px;}
  .welcome-overlay h1{font-family:var(--serif);font-size:28px;margin:0 0 10px;}
  .welcome-overlay p{font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0 0 34px;max-width:320px;}
  .welcome-overlay button{padding:14px 40px;background:var(--ink);color:var(--white);border:none;border-radius:var(--radius);font-family:var(--mono);font-size:12px;letter-spacing:1px;text-transform:uppercase;cursor:pointer;}

  h2.screen-title{font-family:var(--serif);font-size:22px;margin:0 0 20px;}

  .brand-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;padding-top:4px;}
  .clear-btn{background:none;border:1px solid var(--paper-line);color:var(--ink-soft);font-family:var(--mono);font-size:10px;letter-spacing:0.6px;text-transform:uppercase;padding:7px 12px;border-radius:var(--radius);cursor:pointer;}
  .clear-btn:active{border-color:var(--stamp);color:var(--stamp);}

  .doc-subtabs{display:flex;gap:8px;margin-bottom:14px;}
  .subtab-btn{flex:1;padding:10px;font-family:var(--mono);font-size:11px;letter-spacing:0.8px;text-transform:uppercase;border:1px solid var(--ink);background:transparent;color:var(--ink);border-radius:var(--radius);cursor:pointer;}
  .subtab-btn.active{background:var(--ink);color:var(--white);}

  .doc-controls{display:flex;gap:8px;margin-bottom:16px;}
  .doc-controls input{flex:1.6;}
  .doc-controls select{flex:1;}

  .hist-actions{display:flex;gap:8px;margin-top:10px;}
  .mini-btn{flex:1;padding:9px;font-family:var(--mono);font-size:10px;letter-spacing:0.5px;text-transform:uppercase;border:1px solid var(--ink);background:transparent;color:var(--ink);border-radius:var(--radius);cursor:pointer;-webkit-tap-highlight-color:transparent;touch-action:manipulation;}
  .mini-btn:active{background:var(--ink);color:var(--white);}
  .mini-btn.danger{border-color:var(--stamp);color:var(--stamp);}
  .mini-btn.danger:active{background:var(--stamp);color:var(--white);}
  .hist-item.locked{cursor:default;}
  .draft-badge{display:inline-block;font-family:var(--mono);font-size:8.5px;letter-spacing:0.6px;text-transform:uppercase;color:var(--brass);border:1px solid var(--brass);border-radius:var(--radius);padding:2px 6px;margin-bottom:6px;}

  .snapshot-card{margin-bottom:14px;}
  .snapshot-row{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:11.5px;background:var(--white);border:1px solid var(--paper-line);border-radius:var(--radius);padding:11px 13px;margin-bottom:8px;}
  .snapshot-row .snapshot-label{font-family:var(--mono);font-weight:600;color:var(--brass);text-transform:uppercase;font-size:9.5px;letter-spacing:0.6px;width:100%;}

  .recur-banner.overdue-banner{background:#F3DEDA;border-color:var(--stamp);}
  .badge-overdue{display:inline-block;font-family:var(--mono);font-size:8.5px;letter-spacing:0.6px;text-transform:uppercase;border-radius:var(--radius);padding:2px 6px;margin-left:8px;background:var(--stamp);color:var(--white);}

  .badge-paid,.badge-unpaid{display:inline-block;font-family:var(--mono);font-size:8.5px;letter-spacing:0.6px;text-transform:uppercase;border-radius:var(--radius);padding:2px 6px;margin-left:8px;}
  .badge-paid{color:#3D7A4F;border:1px solid #3D7A4F;}
  .badge-unpaid{color:var(--stamp);border:1px solid var(--stamp);}
  .recur-badge{display:inline-block;font-family:var(--mono);font-size:8.5px;letter-spacing:0.6px;text-transform:uppercase;color:var(--ink-soft);border:1px solid var(--paper-line);border-radius:var(--radius);padding:2px 6px;margin-left:8px;}

  .doc-controls-row2{display:flex;gap:8px;margin-bottom:16px;}
  .doc-controls-row2 select{flex:1;}

  .recur-banner{display:none;background:var(--brass-soft);border:1px solid var(--brass);border-radius:var(--radius);padding:12px 14px;margin-bottom:16px;}
  .recur-banner-title{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:0.8px;color:var(--brass);font-weight:600;margin-bottom:8px;}
  .recur-row{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12.5px;padding:6px 0;border-top:1px dashed var(--paper-line);}
  .recur-row:first-of-type{border-top:none;}
  .recur-row .mini-btn{flex:none;padding:6px 10px;}

  .recurring-toggle{display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;}
  .recurring-toggle input{width:auto;}

  .client-picker-row{margin-bottom:10px;}
  .tab-btn{min-width:0;}
</style>
</head>
<body>

<div class="welcome-overlay" id="welcomeOverlay">
  <div class="brand-mark">L</div>
  <h1>Ledger</h1>
  <p>Create invoices and quotes, save your clients, and export polished PDFs — all on your device.</p>
  <button id="welcomeBtn" type="button">Get Started</button>
</div>

<div class="app">

  <!-- ============ HOME ============ -->
  <div class="screen active" id="screen-home">
    <div class="brand-row">
      <div class="brand">
        <div class="brand-mark">L</div>
        <h1>Ledger</h1>
        <span class="tag">Invoices &amp; Quotes</span>
      </div>
      <button class="clear-btn" id="clearBtn" type="button">Clear</button>
    </div>

    <div class="field-group">
      <span class="grp-label">Document</span>
      <div class="row">
        <div><label class="small">Type</label>
          <select id="docKind">
            <option value="INVOICE">Invoice</option>
            <option value="QUOTE">Quote</option>
          </select>
        </div>
        <div><label class="small">Number</label><input type="text" id="docNum" value="0001"></div>
      </div>
      <div class="row">
        <div><label class="small">Date</label><input type="date" id="docDate"></div>
        <div><label class="small">Due date</label><input type="date" id="dueDate"></div>
      </div>
      <div class="row">
        <div><label class="small">Currency</label>
          <select id="docCurrency">
            <option value="USD">USD ($)</option>
            <option value="EUR">EUR (€)</option>
            <option value="GBP">GBP (£)</option>
            <option value="INR">INR (₹)</option>
            <option value="AUD">AUD (A$)</option>
            <option value="CAD">CAD (C$)</option>
            <option value="JPY">JPY (¥)</option>
          </select>
        </div>
        <div></div>
      </div>
    </div>

    <div class="field-group">
      <span class="grp-label">Recurring</span>
      <label class="recurring-toggle">
        <input type="checkbox" id="recurringEnabled">
        Repeat this invoice automatically
      </label>
      <div class="row" id="recurringFreqRow" style="display:none;margin-top:10px;">
        <div><label class="small">Frequency</label>
          <select id="recurringFrequency">
            <option value="weekly">Weekly</option>
            <option value="monthly" selected>Monthly</option>
            <option value="quarterly">Quarterly</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
        <div></div>
      </div>
      <input type="hidden" id="recurringNextDate" value="">
    </div>

    <div class="field-group">
      <span class="grp-label">Your business</span>
      <div class="row"><input type="text" id="fromName" placeholder="Business or your name"></div>
      <div class="row"><textarea id="fromMeta" placeholder="Email, phone, address (one per line)"></textarea></div>
    </div>

    <div class="field-group">
      <span class="grp-label">Bill to</span>
      <div class="row client-picker-row">
        <select id="clientPicker">
          <option value="">— Choose a saved client (optional) —</option>
        </select>
      </div>
      <div class="row"><input type="text" id="toName" placeholder="Client name"></div>
      <div class="row"><textarea id="toMeta" placeholder="Client email, company, address"></textarea></div>
      <button class="add-item" id="saveAsClientBtn" type="button">+ Save as new client</button>
    </div>

    <div class="field-group">
      <span class="grp-label">Line items</span>
      <div class="items" id="itemsWrap"></div>
      <button class="add-item" id="addItemBtn" type="button">+ Add line item</button>
    </div>

    <div class="field-group">
      <span class="grp-label">Tax &amp; discount</span>
      <div class="row">
        <div><label class="small">Tax %</label><input type="number" id="taxRate" value="0" step="0.1"></div>
        <div><label class="small">Discount %</label><input type="number" id="discRate" value="0" step="0.1"></div>
      </div>
    </div>

    <div class="field-group">
      <span class="grp-label">Notes</span>
      <textarea id="notes" placeholder="Payment terms, thank-you note, bank details...">Thanks for your business! Payment due within 14 days.</textarea>
    </div>

    <div class="preview-toggle">
      <button type="button" id="tabEdit" class="active">Edit</button>
      <button type="button" id="tabPreview">Preview</button>
    </div>

    <div class="sheet-wrap" id="sheetWrap">
      <div class="sheet" id="sheet">
        <div class="sheet-logo-bg" id="sheetLogoBg"></div>
        <div class="sheet-content">
        <div class="sheet-head">
          <div class="sheet-brand">
            <h2 id="pFromName">Your Business</h2>
            <p id="pFromMeta">your@email.com</p>
          </div>
          <div class="doc-type">
            <div class="kind" id="pKind">Invoice</div>
            <div class="num" id="pNum">#0001</div>
            <div class="date" id="pDate">—</div>
          </div>
        </div>

        <div class="bill-to">
          <div class="grp-label">Bill to</div>
          <div class="name" id="pToName">Client name</div>
          <div class="meta" id="pToMeta"></div>
        </div>

        <table class="items-table">
          <thead>
            <tr><th>Description</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr>
          </thead>
          <tbody id="pItemsBody"></tbody>
        </table>

        <div class="totals">
          <div class="trow"><span>Subtotal</span><span id="pSubtotal">0.00</span></div>
          <div class="trow" id="pDiscRow" style="display:none;"><span>Discount</span><span id="pDisc">0.00</span></div>
          <div class="trow" id="pTaxRow" style="display:none;"><span>Tax</span><span id="pTax">0.00</span></div>
          <div class="trow grand"><span>Total</span><span id="pTotal">0.00</span></div>
        </div>

        <div class="notes-block">
          <div class="grp-label">Notes</div>
          <p id="pNotes"></p>
        </div>

        <div class="stamp-el" id="pStamp"><span id="pStampText">Due<br>14 days</span></div>
        <div class="watermark" id="pWatermark">Made with Ledger — ledger.app</div>
        </div>
      </div>

      <button class="btn-primary" id="downloadBtn" type="button">Download as PDF</button>
      <button class="btn-secondary" id="saveBtn" type="button">Save as Draft</button>
    </div>
  </div>

  <!-- ============ CLIENTS ============ -->
  <div class="screen" id="screen-clients">
    <h2 class="screen-title">Clients</h2>

    <div class="field-group">
      <span class="grp-label">Add a new client</span>
      <div class="row"><input type="text" id="newClientName" placeholder="Client name"></div>
      <div class="row"><textarea id="newClientMeta" placeholder="Email, phone, address"></textarea></div>
      <button class="btn-primary" id="addClientBtn" type="button">+ Add Client</button>
