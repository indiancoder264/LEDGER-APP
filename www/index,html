document.getElementById('saveBtn').addEventListener('click', () => {
  const state = getCurrentState();
  const t = computeTotals(state);
  let drafts = safeParse(lsGet('drafts')) || [];

  if(currentDraftId){
    const idx = drafts.findIndex(d => d.id === currentDraftId);
    const createdAt = idx >= 0 ? drafts[idx].createdAt : Date.now();
    const updated = { id: currentDraftId, kind: state.docKind, num: state.docNum || '0001',
      toName: state.toName || 'Client name', total: t.total, createdAt, state };
    if(idx >= 0) drafts[idx] = updated; else drafts.unshift(updated);
  } else {
    currentDraftId = 'draft_' + Date.now();
    drafts.unshift({ id: currentDraftId, kind: state.docKind, num: state.docNum || '0001',
      toName: state.toName || 'Client name', total: t.total, createdAt: Date.now(), state });
  }
  lsSet('drafts', JSON.stringify(drafts));

  const orig = document.getElementById('saveBtn').textContent;
  document.getElementById('saveBtn').textContent = 'Saved ✓';
