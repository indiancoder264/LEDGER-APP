document.getElementById('importBackupInput').addEventListener('change', function(e){
  const file = e.target.files[0];
  if(!file) return;
  const status = document.getElementById('backupStatus');
  const reader = new FileReader();
  reader.onload = function(evt){
    try{
      const backup = JSON.parse(evt.target.result);
      if(!confirm('Import this backup? This will replace your current Documents, Drafts, Clients, and Profile on this device.')){
        e.target.value = '';
        return;
      }
      if(backup.documents) lsSet('documents', JSON.stringify(backup.documents));
      if(backup.drafts) lsSet('drafts', JSON.stringify(backup.drafts));
      if(backup.clients) lsSet('clients', JSON.stringify(backup.clients));
      if(backup.profile) lsSet('profile', JSON.stringify(backup.profile));
      if(backup.proCode) lsSet('pro-code', backup.proCode);
      if(backup.logoWatermark) lsSet('logoWatermark', backup.logoWatermark);

      // Refresh everything the restored data touches.
      const profile = safeParse(lsGet('profile'));
      if(profile){
        document.getElementById('fromName').value = profile.name || '';
        document.getElementById('fromMeta').value = profile.meta || '';
        document.getElementById('profName').value = profile.name || '';
        document.getElementById('profMeta').value = profile.meta || '';
        document.getElementById('profCurrency').value = profile.defaultCurrency || 'USD';
      }
      const savedProCode = lsGet('pro-code');
      proUnlocked = !!(savedProCode && savedProCode.length >= 6);
      if(proUnlocked) document.getElementById('unlockCode').value = savedProCode;

      updateProGatedUI();
      applyLogoWatermark();
      populateClientPicker();
      renderClientsList();
      renderDocumentsList();
      renderRecurringBanner();
      renderOverdueBanner();
      renderSnapshot();
      renderPreview();

      status.textContent = 'Backup imported successfully.';
      status.className = 'pro-status active';
    }catch(err){
      console.error('Backup import failed', err);
      status.textContent = "That file doesn't look like a valid Ledger backup.";
      status.className = 'pro-status inactive';
    }
    e.target.value = '';
  };
  reader.readAsText(file);
});

