document.getElementById('logoInput').addEventListener('change', function(e){
  const file = e.target.files[0];
  if(!file) return;
  if(file.size > 4 * 1024 * 1024){
    alert('That image is too large. Please choose a logo under 4MB.');
    e.target.value = '';
    return;
  }
  const reader = new FileReader();
  reader.onload = function(ev){
    const img = new Image();
    img.onload = function(){
      // Pre-fade the logo to a subtle watermark opacity once, at upload time,
      // so both the live preview and the PDF just place a ready-made faint image.
      const canvas = document.createElement('canvas');
      canvas.width = img.width;
      canvas.height = img.height;
      const ctx = canvas.getContext('2d');
      ctx.globalAlpha = 0.08;
      ctx.drawImage(img, 0, 0);
      const faded = canvas.toDataURL('image/png');
      lsSet('logoWatermark', faded);
      applyLogoWatermark();
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
});

