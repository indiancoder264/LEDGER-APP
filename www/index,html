function renderDocumentsList(){
  const wrap = document.getElementById('historyList');
  const key = activeDocTab === 'drafts' ? 'drafts' : 'documents';
  let list = safeParse(lsGet(key)) || [];

  const q = (document.getElementById('docSearch').value || '').toLowerCase().trim();
  if(q){
    list = list.filter(r =>
      (r.toName || '').toLowerCase().includes(q) ||
      (r.num || '').toLowerCase().includes(q)
    );
  }
  if(activeDocTab === 'documents'){
    const statusVal = document.getElementById('statusFilter').value;
    if(statusVal !== 'all'){
      list = list.filter(r => (r.status || 'unpaid') === statusVal);
    }
  }
  const sortDir = document.getElementById('docSort').value;
  list = list.slice().sort((a, b) => sortDir === 'old' ? a.createdAt - b.createdAt : b.createdAt - a.createdAt);

  if(list.length === 0){
    wrap.innerHTML = activeDocTab === 'drafts'
      ? `<div class="empty-state"><div class="icon">&#128221;</div><p>No drafts saved yet.<br>Create a document on Home, then tap<br>"Save as Draft".</p></div>`
      : `<div class="empty-state"><div class="icon">&#128203;</div><p>No documents yet.<br>Every PDF you download is<br>saved here automatically.</p></div>`;
    return;
  }

  wrap.innerHTML = '';
  list.forEach(rec => {
    const el = document.createElement('div');
    el.className = 'hist-item';
    const d = new Date(rec.createdAt);
    const isPaid = rec.status === 'paid';
    const overdue = isOverdue(rec);
    const isRecurring = rec.state && rec.state.recurring && rec.state.recurring.enabled;

    const actionsHtml = activeDocTab === 'drafts'
      ? `<div class="hist-actions">
           <button class="mini-btn" data-action="edit" data-id="${rec.id}">Edit</button>
           <button class="mini-btn danger" data-action="delete" data-id="${rec.id}">Delete</button>
         </div>`
      : `<div class="hist-actions">
           <button class="mini-btn" data-action="redownload" data-id="${rec.id}">Download again</button>
           <button class="mini-btn" data-action="togglePaid" data-id="${rec.id}">${isPaid ? 'Mark Unpaid' : 'Mark Paid'}</button>
         </div>`;

    let statusBadge = '';
    if(activeDocTab === 'documents'){
      if(isPaid) statusBadge = '<span class="badge-paid">Paid</span>';
      else if(overdue) statusBadge = '<span class="badge-overdue">Overdue</span>';
      else statusBadge = '<span class="badge-unpaid">Unpaid</span>';
    }

    el.innerHTML = `
      ${activeDocTab === 'drafts' ? '<span class="draft-badge">Draft</span><br>' : ''}
      <div class="hist-top">
        <span class="kind-num">${rec.kind === 'QUOTE' ? 'QUOTE' : 'INVOICE'} #${escapeHtml(rec.num)}
          ${statusBadge}
          ${isRecurring ? '<span class="recur-badge">Recurring</span>' : ''}
        </span>
        <span class="amt">${money(rec.total, rec.currency || 'USD')}</span>
      </div>
      <div class="hist-mid">${escapeHtml(rec.toName)}</div>
      <div class="hist-date">${d.toLocaleDateString()} · ${d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</div>
      ${actionsHtml}
    `;
    wrap.appendChild(el);
  });

  wrap.querySelectorAll('.mini-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.id;
      const action = btn.dataset.action;
      const listKey = activeDocTab === 'drafts' ? 'drafts' : 'documents';
      const currentList = safeParse(lsGet(listKey)) || [];
      const rec = currentList.find(r => r.id === id);
      if(!rec) return;

      if(action === 'edit'){
        loadDraftIntoEditor(rec);
      } else if(action === 'delete'){
        if(confirm('Delete this draft? This cannot be undone.')){
          lsSet('drafts', JSON.stringify(currentList.filter(r => r.id !== id)));
          renderDocumentsList();
        }
      } else if(action === 'redownload'){
        redownloadDocument(rec);
      } else if(action === 'togglePaid'){
        rec.status = rec.status === 'paid' ? 'unpaid' : 'paid';
        lsSet('documents', JSON.stringify(currentList));
        renderDocumentsList();
        renderOverdueBanner();
        renderSnapshot();
      }
    });
  });
}

