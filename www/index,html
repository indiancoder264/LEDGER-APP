  }

  try{
    const profile = JSON.parse(lsGet('profile') || 'null');
    if(profile){
      document.getElementById('fromName').value = profile.name || '';
      document.getElementById('fromMeta').value = profile.meta || '';
      document.getElementById('profName').value = profile.name || '';
      document.getElementById('profMeta').value = profile.meta || '';
      document.getElementById('profCurrency').value = profile.defaultCurrency || 'USD';
      document.getElementById('docCurrency').value = profile.defaultCurrency || 'USD';
    }
  }catch(e){}

  if(!lsGet('seenWelcome')){
    addItem('Design consultation', 4, 75);
    addItem('Website development', 1, 950);
  } else {
    addItem('', 1, 0);
  }

  updateProGatedUI();
  applyLogoWatermark();
  populateClientPicker();
  renderRecurringBanner();
  renderPreview();
}
init();
</script>
</body>
</html>
