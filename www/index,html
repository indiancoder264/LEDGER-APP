<script>
let itemIdCounter = 0;
let items = [];
let proUnlocked = false;
let currentDraftId = null;    // set while editing a saved draft
let currentHistoryId = null;  // set once the current document has been downloaded at least once
let activeDocTab = 'documents'; // 'documents' (History) or 'drafts', for the Documents screen

// ---- Storage (plain localStorage — native on Android, no setup needed) ----
function lsSet(key, value){ try{ localStorage.setItem(key, value); }catch(e){ console.error(e); } }
function lsGet(key){ try{ return localStorage.getItem(key); }catch(e){ return null; } }
function safeParse(json){ try{ return JSON.parse(json); }catch(e){ return null; } }
function nextDocNumber(){
  const docs = safeParse(lsGet('documents')) || [];
  const drafts = safeParse(lsGet('drafts')) || [];
  return String(docs.length + drafts.length + 1).padStart(4, '0');
}

// ============ TAB NAVIGATION ============
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('screen-' + btn.dataset.screen).classList.add('active');
    if(btn.dataset.screen === 'history'){ renderDocumentsList(); renderRecurringBanner(); renderOverdueBanner(); renderSnapshot(); }
    if(btn.dataset.screen === 'clients') renderClientsList();
    if(btn.dataset.screen === 'profile'){
      const status = document.getElementById('profStatus');
      status.textContent = '';
      status.className = 'pro-status inactive';
    }
  });
});

document.querySelectorAll('.subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.subtab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeDocTab = btn.dataset.sub;
    document.getElementById('statusFilterRow').style.display = activeDocTab === 'documents' ? 'flex' : 'none';
    renderDocumentsList();
  });
});
document.getElementById('docSearch').addEventListener('input', renderDocumentsList);
document.getElementById('docSort').addEventListener('change', renderDocumentsList);
document.getElementById('statusFilter').addEventListener('change', renderDocumentsList);

document.getElementById('recurringEnabled').addEventListener('change', function(){
  document.getElementById('recurringFreqRow').style.display = this.checked ? 'flex' : 'none';
});

document.getElementById('tabEdit').addEventListener('click', () => setEditPreview(true));
document.getElementById('tabPreview').addEventListener('click', () => setEditPreview(false));
function setEditPreview(editing){
  document.getElementById('tabEdit').classList.toggle('active', editing);
  document.getElementById('tabPreview').classList.toggle('active', !editing);
  document.getElementById('sheetWrap').classList.toggle('active', !editing);
  // hide the edit fields' field-groups when previewing (keep header + toggle visible)
  document.querySelectorAll('#screen-home > .field-group').forEach(el => {
    el.style.display = editing ? '' : 'none';
  });
}

// ============ CLEAR ============
document.getElementById('clearBtn').addEventListener('click', () => {
  if(!confirm('Clear this document? Your business profile info will be kept.')) return;
  currentDraftId = null;
  currentHistoryId = null;

  document.getElementById('docKind').value = 'INVOICE';
  document.getElementById('docNum').value = nextDocNumber();
  const today = new Date().toISOString().slice(0,10);
  document.getElementById('docDate').value = today;
  const due = new Date(); due.setDate(due.getDate()+14);
  document.getElementById('dueDate').value = due.toISOString().slice(0,10);

  // fromName / fromMeta are left untouched — they come from Profile.
  const profile = safeParse(lsGet('profile'));
  document.getElementById('docCurrency').value = (profile && profile.defaultCurrency) || 'USD';
  document.getElementById('toName').value = '';
  document.getElementById('toMeta').value = '';
  document.getElementById('clientPicker').value = '';
  document.getElementById('taxRate').value = 0;
  document.getElementById('discRate').value = 0;
  document.getElementById('notes').value = '';
  document.getElementById('recurringEnabled').checked = false;
  document.getElementById('recurringFrequency').value = 'monthly';
  document.getElementById('recurringNextDate').value = '';
  document.getElementById('recurringFreqRow').style.display = 'none';

  items = [];
  itemIdCounter = 0;
  addItem('', 1, 0);
  renderPreview();
  setEditPreview(true);
});

// ============ WELCOME OVERLAY ============
document.getElementById('welcomeBtn').addEventListener('click', () => {
  document.getElementById('welcomeOverlay').style.display = 'none';
  lsSet('seenWelcome', '1');
});
if(lsGet('seenWelcome')){
  document.getElementById('welcomeOverlay').style.display = 'none';
}

// ============ LINE ITEMS ============
function addItem(desc='', qty=1, rate=0){
  const id = itemIdCounter++;
  items.push({id, desc, qty, rate});
  renderItemsForm();
  renderPreview();
}
function removeItem(id){
  items = items.filter(i => i.id !== id);
  renderItemsForm();
  renderPreview();
}
function renderItemsForm(){
  const wrap = document.getElementById('itemsWrap');
  wrap.innerHTML = '';
  items.forEach(item => {
    const row = document.createElement('div');
    row.className = 'item-row';
    row.innerHTML = `
      <input type="text" placeholder="Description" value="${escapeAttr(item.desc)}" data-id="${item.id}" data-field="desc">
      <input type="number" placeholder="Qty" value="${item.qty}" data-id="${item.id}" data-field="qty" min="0" step="0.5">
      <input type="number" placeholder="Rate" value="${item.rate}" data-id="${item.id}" data-field="rate" min="0" step="0.01">
      <button class="rm" data-id="${item.id}" title="Remove">×</button>
    `;
    wrap.appendChild(row);
  });
  wrap.querySelectorAll('input').forEach(inp => {
    inp.addEventListener('input', (e) => {
      const id = parseInt(e.target.dataset.id);
      const field = e.target.dataset.field;
      const item = items.find(i => i.id === id);
      if(!item) return;
      item[field] = field === 'desc' ? e.target.value : parseFloat(e.target.value || 0);
      renderPreview();
    });
  });
  wrap.querySelectorAll('.rm').forEach(btn => {
    btn.addEventListener('click', (e) => removeItem(parseInt(e.target.dataset.id)));
  });
}
function escapeAttr(s){ return (s||'').replace(/"/g,'&quot;'); }
function escapeHtml(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
const CURRENCY_SYMBOLS = { USD:'$', EUR:'€', GBP:'£', INR:'₹', AUD:'A$', CAD:'C$', JPY:'¥' };
function money(n, code){
  const sym = CURRENCY_SYMBOLS[code] || '$';
  if(code === 'JPY') return sym + Math.round(n || 0).toString();
  return sym + (Math.round((n||0)*100)/100).toFixed(2);
}

function getCurrentState(){
  return {
    docKind: document.getElementById('docKind').value,
    docNum: document.getElementById('docNum').value,
    docDate: document.getElementById('docDate').value,
    dueDate: document.getElementById('dueDate').value,
    currency: document.getElementById('docCurrency').value,
    recurring: {
      enabled: document.getElementById('recurringEnabled').checked,
      frequency: document.getElementById('recurringFrequency').value,
      nextDate: document.getElementById('recurringNextDate').value || null
    },
    fromName: document.getElementById('fromName').value,
    fromMeta: document.getElementById('fromMeta').value,
    toName: document.getElementById('toName').value,
    toMeta: document.getElementById('toMeta').value,
    taxRate: document.getElementById('taxRate').value,
    discRate: document.getElementById('discRate').value,
    notes: document.getElementById('notes').value,
    items: items.map(i => ({ desc: i.desc, qty: i.qty, rate: i.rate }))
  };
}

function computeTotals(state){
  let subtotal = 0;
  (state.items || []).forEach(item => { subtotal += (item.qty||0) * (item.rate||0); });
  const discRate = parseFloat(state.discRate || 0);
  const taxRate = parseFloat(state.taxRate || 0);
  const discAmt = subtotal * (discRate/100);
  const taxable = subtotal - discAmt;
  const taxAmt = taxable * (taxRate/100);
  return { subtotal, discRate, taxRate, discAmt, taxAmt, total: taxable + taxAmt };
}

function currentTotals(){
  return computeTotals(getCurrentState());
}

function renderPreview(){
  document.getElementById('pFromName').textContent = document.getElementById('fromName').value || 'Your Business';
  document.getElementById('pFromMeta').textContent = document.getElementById('fromMeta').value || '';
  document.getElementById('pToName').textContent = document.getElementById('toName').value || 'Client name';
  document.getElementById('pToMeta').textContent = document.getElementById('toMeta').value || '';

  const kind = document.getElementById('docKind').value;
  const currency = document.getElementById('docCurrency').value;
  document.getElementById('pKind').textContent = kind === 'QUOTE' ? 'Quote' : 'Invoice';
  document.getElementById('pNum').textContent = '#' + (document.getElementById('docNum').value || '0001');

  const d = document.getElementById('docDate').value;
  const due = document.getElementById('dueDate').value;
  document.getElementById('pDate').textContent = d ? ('Issued ' + formatDate(d)) : '';

  const body = document.getElementById('pItemsBody');
  body.innerHTML = '';
  items.forEach(item => {
    const amt = (item.qty||0) * (item.rate||0);
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${escapeHtml(item.desc) || '—'}</td><td class="num">${item.qty||0}</td><td class="num">${money(item.rate||0, currency)}</td><td class="num">${money(amt, currency)}</td>`;
    body.appendChild(tr);
  });

  const t = currentTotals();
  document.getElementById('pSubtotal').textContent = money(t.subtotal, currency);
  document.getElementById('pDiscRow').style.display = t.discRate > 0 ? 'flex' : 'none';
  document.getElementById('pDisc').textContent = '-' + money(t.discAmt, currency);
  document.getElementById('pTaxRow').style.display = t.taxRate > 0 ? 'flex' : 'none';
  document.getElementById('pTax').textContent = money(t.taxAmt, currency);
  document.getElementById('pTotal').textContent = money(t.total, currency);

  document.getElementById('pNotes').textContent = document.getElementById('notes').value || '';
  document.getElementById('pStampText').innerHTML = kind === 'QUOTE' ? 'Valid<br>30 days' : (due ? 'Due<br>' + formatDate(due, true) : 'Payment<br>due');
  document.getElementById('pWatermark').style.display = proUnlocked ? 'none' : 'block';
}
function formatDate(str, short=false){
  const dt = new Date(str + 'T00:00:00');
  if(isNaN(dt)) return '';
  if(short) return dt.toLocaleDateString('en-US', {month:'short', day:'numeric'});
  return dt.toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'});
}

['docKind','docNum','docDate','dueDate','fromName','fromMeta','toName','toMeta','taxRate','discRate','notes'].forEach(id => {
  document.getElementById(id).addEventListener('input', renderPreview);
  document.getElementById(id).addEventListener('change', renderPreview);
});
document.getElementById('addItemBtn').addEventListener('click', () => addItem());

// ============ PDF GENERATION (native, with fallback) ============
document.getElementById('downloadBtn').addEventListener('click', () => generateAndSharePDF());

function buildPdfDoc(state){
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'letter' });
  const pageW = doc.internal.pageSize.getWidth();
  const pageH = doc.internal.pageSize.getHeight();
  const margin = 48;
  let y = margin;

  // Logo watermark (Pro feature) — drawn first so it sits behind all other content.
  if(proUnlocked){
    const logoData = lsGet('logoWatermark');
    if(logoData){
      try{
        const props = doc.getImageProperties(logoData);
        const maxW = pageW * 0.55;
        const maxH = pageH * 0.4;
        const scale = Math.min(maxW / props.width, maxH / props.height);
        const w = props.width * scale;
        const h = props.height * scale;
        doc.addImage(logoData, props.fileType, (pageW - w) / 2, (pageH - h) / 2, w, h);
      }catch(logoErr){
        console.error('Could not draw logo watermark', logoErr);
      }
    }
  }

  const kind = state.docKind === 'QUOTE' ? 'QUOTE' : 'INVOICE';
  const num = state.docNum || '0001';
  const fromName = state.fromName || 'Your Business';
  const fromMeta = state.fromMeta || '';
  const toName = state.toName || 'Client name';
  const toMeta = state.toMeta || '';
  const dateStr = state.docDate ? ('Issued ' + formatDate(state.docDate)) : '';
  const notes = state.notes || '';
  const stateItems = state.items || [];

  doc.setFont('times', 'bold'); doc.setFontSize(20);
  doc.text(fromName, margin, y);
  doc.setFont('helvetica', 'bold'); doc.setFontSize(10);
  doc.setTextColor(161, 61, 44);
  doc.text(kind, pageW - margin, margin - 6, { align: 'right' });
  doc.setTextColor(31, 45, 61);
  doc.setFont('times', 'normal'); doc.setFontSize(13);
  doc.text('#' + num, pageW - margin, margin + 12, { align: 'right' });
  doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
  doc.setTextColor(91, 100, 112);
  doc.text(dateStr, pageW - margin, margin + 26, { align: 'right' });

  y += 20;
  doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
  fromMeta.split('\n').forEach(line => { if(line.trim()){ doc.text(line, margin, y); y += 12; } });

  y += 10;
  doc.setDrawColor(31, 45, 61); doc.setLineWidth(1.2);
  doc.line(margin, y, pageW - margin, y);
  y += 26;

  doc.setTextColor(166, 135, 79); doc.setFontSize(8); doc.setFont('helvetica', 'bold');
  doc.text('BILL TO', margin, y);
  y += 14;
  doc.setTextColor(31, 45, 61); doc.setFont('times', 'normal'); doc.setFontSize(13);
  doc.text(toName, margin, y);
  y += 14;
  doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(91, 100, 112);
  toMeta.split('\n').forEach(line => { if(line.trim()){ doc.text(line, margin, y); y += 12; } });

  y += 16;
  doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(91, 100, 112);
  doc.text('DESCRIPTION', margin, y);
  doc.text('QTY', pageW - margin - 160, y, { align: 'right' });
  doc.text('RATE', pageW - margin - 80, y, { align: 'right' });
  doc.text('AMOUNT', pageW - margin, y, { align: 'right' });
  y += 6;
  doc.setDrawColor(31, 45, 61); doc.setLineWidth(1);
  doc.line(margin, y, pageW - margin, y);
  y += 16;

  doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(31, 45, 61);
  const curr = state.currency || 'USD';
  stateItems.forEach(item => {
    const amt = (item.qty||0) * (item.rate||0);
    doc.text(item.desc || '—', margin, y);
    doc.text(String(item.qty||0), pageW - margin - 160, y, { align: 'right' });
    doc.text(money(item.rate||0, curr), pageW - margin - 80, y, { align: 'right' });
    doc.text(money(amt, curr), pageW - margin, y, { align: 'right' });
    y += 8;
    doc.setDrawColor(217, 211, 193); doc.setLineWidth(0.5);
    doc.line(margin, y, pageW - margin, y);
    y += 16;
  });

  const t = computeTotals(state);
  y += 6;
  doc.setFontSize(10);
  doc.text('Subtotal', pageW - margin - 140, y);
  doc.text(money(t.subtotal, curr), pageW - margin, y, { align: 'right' });
  y += 16;
  if(t.discRate > 0){
    doc.text('Discount', pageW - margin - 140, y);
    doc.text('-' + money(t.discAmt, curr), pageW - margin, y, { align: 'right' });
    y += 16;
  }
  if(t.taxRate > 0){
    doc.text('Tax', pageW - margin - 140, y);
    doc.text(money(t.taxAmt, curr), pageW - margin, y, { align: 'right' });
    y += 16;
  }
  doc.setDrawColor(31, 45, 61); doc.setLineWidth(1.2);
  doc.line(pageW - margin - 140, y, pageW - margin, y);
  y += 16;
  doc.setFont('times', 'bold'); doc.setFontSize(15);
  doc.text('Total', pageW - margin - 140, y);
  doc.text(money(t.total, curr), pageW - margin, y, { align: 'right' });

  y += 34;
  doc.setDrawColor(217, 211, 193); doc.setLineWidth(0.5);
  doc.line(margin, y, pageW - margin, y);
  y += 18;
  doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(166, 135, 79);
  doc.text('NOTES', margin, y);
  y += 12;
  doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(91, 100, 112);
  doc.splitTextToSize(notes, pageW - margin*2).forEach(line => { doc.text(line, margin, y); y += 12; });

  if(!proUnlocked){
    doc.setFontSize(8); doc.setTextColor(217, 211, 193);
    doc.text('Made with Ledger', pageW/2, doc.internal.pageSize.getHeight() - 30, { align: 'center' });
  }

  return { doc, fileName: buildFileName(kind, num, toName) };
}

function buildFileName(kind, num, clientName){
  const kindLabel = kind === 'QUOTE' ? 'Quote' : 'Invoice';
  const slug = (clientName || 'Client').trim()
    .replace(/[^a-zA-Z0-9]+/g, '-')
    .replace(/(^-+|-+$)/g, '') || 'Client';
  return `${kindLabel}-${num}-${slug}.pdf`;
}

// Writes a PDF to persistent phone storage and opens the native share sheet.
// Falls back to a normal browser-style download if native plugins aren't available.
async function writeAndSharePdf(doc, fileName){
  const base64 = doc.output('datauristring').split(',')[1];
  const Cap = window.Capacitor;
  if(Cap && Cap.Plugins && Cap.Plugins.Filesystem){
    try{
      const { Filesystem, Share } = Cap.Plugins;
      const written = await Filesystem.writeFile({
        path: fileName,
        data: base64,
        directory: 'DOCUMENTS'  // persistent storage — survives app cache clears
      });
      if(Share){
        await Share.share({ title: fileName, url: written.uri });
      }
      return true;
    }catch(nativeErr){
      console.error('Native save/share failed, falling back:', nativeErr);
    }
  }
  doc.save(fileName);
  return false;
}

async function generateAndSharePDF(){
  const btn = document.getElementById('downloadBtn');

  // Guardrails — only relevant the first time this document is being created,
  // not on repeat downloads of something already saved to History.
  if(!currentHistoryId){
    const precheck = getCurrentState();
    if(!precheck.toName || !precheck.toName.trim()){
      if(!confirm("You haven't entered a client name. Download anyway?")) return;
    }
    const existingDocs = safeParse(lsGet('documents')) || [];
    const isDuplicateNum = existingDocs.some(d =>
      (d.num || '').trim().toLowerCase() === (precheck.docNum || '').trim().toLowerCase()
    );
    if(isDuplicateNum){
      if(!confirm(`An invoice numbered #${precheck.docNum} already exists in History. Continue anyway?`)) return;
    }
  }

  const origLabel = btn.textContent;
  btn.textContent = 'Generating…';
  btn.disabled = true;
  try{
    const state = getCurrentState();
    const { doc, fileName } = buildPdfDoc(state);
    await writeAndSharePdf(doc, fileName);

    // Every download is saved to History exactly once per document.
    // Repeated downloads of the same in-progress document just re-generate the file.
    if(!currentHistoryId){
      if(state.recurring.enabled && !state.recurring.nextDate){
        state.recurring.nextDate = advanceDate(state.docDate, state.recurring.frequency);
        document.getElementById('recurringNextDate').value = state.recurring.nextDate;
      }
      const t = computeTotals(state);
      const id = 'doc_' + Date.now();
      const docs = safeParse(lsGet('documents')) || [];
      docs.unshift({
        id, kind: state.docKind, num: state.docNum || '0001',
        toName: state.toName || 'Client name', total: t.total,
        currency: state.currency || 'USD', status: 'unpaid',
        createdAt: Date.now(), state
      });
      lsSet('documents', JSON.stringify(docs));
      currentHistoryId = id;

      // If this document started life as a draft, it graduates out of Drafts now.
      if(currentDraftId){
        let drafts = safeParse(lsGet('drafts')) || [];
        drafts = drafts.filter(d => d.id !== currentDraftId);
        lsSet('drafts', JSON.stringify(drafts));
        currentDraftId = null;
      }
    }
  } catch(err){
    console.error('PDF generation failed', err);
    alert('Could not generate the PDF.\n\n' + (err && err.message ? err.message : String(err)));
  } finally {
    btn.textContent = origLabel;
    btn.disabled = false;
  }
}

// Re-download an already-saved History document without touching the live editor.
async function redownloadDocument(rec){
  try{
    const { doc, fileName } = buildPdfDoc(rec.state);
    await writeAndSharePdf(doc, fileName);
  }catch(err){
    console.error('Redownload failed', err);
    alert('Could not generate the PDF.\n\n' + (err && err.message ? err.message : String(err)));
  }
}

// ============ RECURRING INVOICES ============
function advanceDate(dateStr, frequency){
  const d = new Date((dateStr || new Date().toISOString().slice(0,10)) + 'T00:00:00');
  if(frequency === 'weekly') d.setDate(d.getDate() + 7);
  else if(frequency === 'quarterly') d.setMonth(d.getMonth() + 3);
  else if(frequency === 'yearly') d.setFullYear(d.getFullYear() + 1);
  else d.setMonth(d.getMonth() + 1); // monthly (default)
  return d.toISOString().slice(0,10);
}

function renderRecurringBanner(){
  const banner = document.getElementById('recurringBanner');
  const docs = safeParse(lsGet('documents')) || [];
  const today = new Date().toISOString().slice(0,10);
  const due = docs.filter(d => d.state && d.state.recurring && d.state.recurring.enabled &&
    d.state.recurring.nextDate && d.state.recurring.nextDate <= today);

  if(due.length === 0){ banner.style.display = 'none'; banner.innerHTML = ''; return; }

  banner.style.display = 'block';
  banner.innerHTML = `<div class="recur-banner-title">${due.length} recurring document${due.length > 1 ? 's' : ''} due</div>` +
    due.map(d => `
      <div class="recur-row">
        <span>${escapeHtml(d.toName)} — ${d.kind === 'QUOTE' ? 'Quote' : 'Invoice'} #${escapeHtml(d.num)}</span>
        <button class="mini-btn" data-recur-id="${d.id}">Generate Now</button>
      </div>
    `).join('');

  banner.querySelectorAll('[data-recur-id]').forEach(btn => {
    btn.addEventListener('click', () => generateRecurringNow(btn.dataset.recurId));
  });
}

function isOverdue(rec){
  const today = new Date().toISOString().slice(0,10);
  return (rec.status || 'unpaid') !== 'paid' && rec.state && rec.state.dueDate && rec.state.dueDate < today;
}

function renderOverdueBanner(){
  const banner = document.getElementById('overdueBanner');
  const docs = safeParse(lsGet('documents')) || [];
  const overdue = docs.filter(isOverdue);

  if(overdue.length === 0){ banner.style.display = 'none'; banner.innerHTML = ''; return; }

  banner.style.display = 'block';
  banner.innerHTML = `<div class="recur-banner-title" style="color:var(--stamp);">${overdue.length} overdue invoice${overdue.length > 1 ? 's' : ''}</div>` +
    overdue.map(d => `
      <div class="recur-row">
        <span>${escapeHtml(d.toName)} — #${escapeHtml(d.num)} · ${money(d.total, d.currency || 'USD')}</span>
      </div>
    `).join('');
}

function renderSnapshot(){
  const el = document.getElementById('snapshotSummary');
  if(!el) return;
  const docs = safeParse(lsGet('documents')) || [];
  const now = new Date();
  const monthDocs = docs.filter(d => {
    const dt = new Date(d.createdAt);
    return dt.getFullYear() === now.getFullYear() && dt.getMonth() === now.getMonth();
  });
  if(monthDocs.length === 0){ el.innerHTML = ''; return; }

  const byCurrency = {};
  monthDocs.forEach(d => {
    const cur = d.currency || 'USD';
    if(!byCurrency[cur]) byCurrency[cur] = { invoiced: 0, paid: 0, outstanding: 0 };
    byCurrency[cur].invoiced += d.total;
    if(d.status === 'paid') byCurrency[cur].paid += d.total;
    else byCurrency[cur].outstanding += d.total;
  });

  el.innerHTML = Object.keys(byCurrency).map(cur => {
    const s = byCurrency[cur];
    return `<div class="snapshot-row">
      <span class="snapshot-label">This month (${cur})</span>
      <span>Invoiced ${money(s.invoiced, cur)}</span>
      <span>Paid ${money(s.paid, cur)}</span>
      <span>Outstanding ${money(s.outstanding, cur)}</span>
    </div>`;
  }).join('');
}

function generateRecurringNow(sourceId){
  const docs = safeParse(lsGet('documents')) || [];
  const original = docs.find(d => d.id === sourceId);
  if(!original) return;

  const newState = JSON.parse(JSON.stringify(original.state));
  newState.docNum = nextDocNumber();
  newState.docDate = new Date().toISOString().slice(0,10);
  const due = new Date(); due.setDate(due.getDate() + 14);
  newState.dueDate = due.toISOString().slice(0,10);
  newState.recurring = { enabled: false, frequency: null, nextDate: null }; // the copy is a one-off

  const t = computeTotals(newState);
  docs.unshift({
    id: 'doc_' + Date.now(), kind: newState.docKind, num: newState.docNum,
    toName: newState.toName || 'Client name', total: t.total,
    currency: newState.currency || 'USD', status: 'unpaid',
    createdAt: Date.now(), state: newState
  });

  // Advance the original template's next due date.
  original.state.recurring.nextDate = advanceDate(original.state.recurring.nextDate, original.state.recurring.frequency);

  lsSet('documents', JSON.stringify(docs));
  renderRecurringBanner();
  renderOverdueBanner();
  renderSnapshot();
  renderDocumentsList();
}

